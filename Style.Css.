
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  font-family: Arial, sans-serif;
  background: #001b08;
  color: #ffffff;
  font-size: 20px;
  line-height: 1.6;
}

header {
  background: #080d18;
  padding: 22px 15px;
  text-align: center;
  border-bottom: 3px solid #00ff41;
}

header h1 {
  color: #00ff41;
  font-size: 32px;
  font-weight: bold;
}

h2 {
  color: #00ff41;
  font-size: 26px;
  margin: 18px 0;
}

h3 {
  color: #69ff8c;
  font-size: 22px;
}

p, li {
  color: #ffffff;
  font-size: 20px;
  font-weight: bold;
  line-height: 1.6;
}

section, .match, .prediction, .card {
  background: #101a2b;
  border: 2px solid #00c853;
  border-radius: 10px;
  padding: 15px;
  margin: 15px 10px;
}

.score, strong {
  color: #00ff41;
  font-size: 20px;
  font-weight: bold;
}

a {
  color: #69ff8c;
  font-weight: bold;
}

button {
  background: #00c853;
  color: #ffffff;
  font-size: 18px;
  font-weight: bold;
  padding: 12px 18px;
  border: none;
  border-radius: 8px;
}

footer {
  background: #080d18;
  color: #ffffff;
  text-align: center;
  padding: 20px 12px;
  border-top: 3px solid #00ff41;
  font-size: 18px;
}

footer a {
  color: #00ff41;
  font-size: 18px;
}

@media (max-width: 600px) {
  header h1 {
    font-size: 32px;
  }

  h2 {
    font-size: 26px;
  }

  p, li {
    font-size: 20px;
  }
}
