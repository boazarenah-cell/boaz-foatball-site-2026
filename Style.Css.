
/* ==========================================
   BOAZ FOOTBALL - PROBABILITY DASHBOARD
   ORIGINAL NAVY AND GREEN IDENTITY
   ========================================== */

.boaz-dashboard,
.boaz-dashboard * {
    box-sizing: border-box;
}

.boaz-dashboard {
    background: #080d18 !important;
    color: #ffffff !important;
    padding: 15px;
    font-family: Arial, sans-serif;
}

.boaz-dashboard h2 {
    color: #00ff41 !important;
    font-size: 28px !important;
    font-weight: 900;
    text-align: center;
}

.boaz-dashboard .match-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 15px;
}

.boaz-dashboard .prob-card {
    background: linear-gradient(145deg, #063b27, #071a19 75%) !important;
    border: 2px solid #087a35 !important;
    border-radius: 14px;
    padding: 17px;
    color: #ffffff !important;
    box-shadow: 0 0 9px rgba(0,255,65,.22);
    min-width: 0;
}

.boaz-dashboard .match-date {
    color: #69ff8c !important;
    font-size: 14px;
    font-weight: bold;
    margin-bottom: 20px;
}

.boaz-dashboard .league-name {
    color: #69ff8c !important;
    font-size: 14px;
    text-align: right;
}

.boaz-dashboard .teams-row {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 8px;
    margin: 20px 0;
}

.boaz-dashboard .team {
    color: #ffffff !important;
    font-size: 19px !important;
    font-weight: 900 !important;
    overflow-wrap: anywhere;
}

.boaz-dashboard .away-team {
    text-align: right;
}

.boaz-dashboard .predicted-score {
    color: #00ff41 !important;
    font-size: 29px !important;
    font-weight: 900 !important;
    text-align: center;
    white-space: nowrap;
}

.boaz-dashboard .predicted-label {
    color: #69ff8c !important;
    text-align: center;
    font-size: 12px;
    font-weight: bold;
}

.boaz-dashboard .prob-numbers {
    display: flex;
    justify-content: space-between;
    font-size: 15px;
    font-weight: 900;
    margin: 15px 0 7px;
}

.boaz-dashboard .home-pct { color: #3994ff !important; }
.boaz-dashboard .draw-pct { color: #dddddd !important; }
.boaz-dashboard .away-pct { color: #ff5555 !important; }

.boaz-dashboard .prob-bar {
    display: flex;
    width: 100%;
    height: 13px;
    overflow: hidden;
    border-radius: 20px;
    background: #333333;
}

.boaz-dashboard .prob-home { background: #237cff; }
.boaz-dashboard .prob-draw { background: #bfc4cc; }
.boaz-dashboard .prob-away { background: #e52e3b; }

.boaz-dashboard .prob-labels {
    display: flex;
    justify-content: space-between;
    color: #ffffff !important;
    font-size: 13px;
    margin-top: 7px;
}

.boaz-dashboard .prediction-result {
    display: inline-block;
    background: #087a35 !important;
    color: #ffffff !important;
    padding: 9px 13px;
    border-radius: 20px;
    font-size: 15px;
    font-weight: 900;
    margin-top: 17px;
}

.boaz-dashboard .confidence {
    color: #69ff8c !important;
    font-size: 15px;
    font-weight: 900;
    float: right;
    margin-top: 22px;
}

.boaz-dashboard .market-info {
    clear: both;
    background: #102b23 !important;
    border: 1px solid #087a35;
    border-radius: 9px;
    padding: 12px;
    margin-top: 15px;
    color: #69ff8c !important;
    font-size: 15px;
    font-weight: bold;
    line-height: 1.8;
}

.boaz-dashboard .prediction-note {
    color: #ffffff !important;
    font-size: 14px;
    margin-top: 12px;
}

.boaz-dashboard .prob-card a {
    display: block;
    background: #101a2b !important;
    color: #69ff8c !important;
    text-align: center;
    padding: 12px;
    border: 1px solid #087a35;
    border-radius: 8px;
    margin-top: 13px;
    text-decoration: none;
    font-size: 15px;
    font-weight: 900;
}

@media(max-width: 850px) {
    .boaz-dashboard .match-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }
}

@media(max-width: 550px) {
    .boaz-dashboard .match-grid {
        grid-template-columns: 1fr;
    }

    .boaz-dashboard .team {
        font-size: 20px !important;
    }

    .boaz-dashboard .predicted-score {
        font-size: 27px !important;
    }
}
