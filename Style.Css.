
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  font-family: Arial, sans-serif;
  background: #050914;
  color: #ffffff;
  font-size: 20px;
  line-height: 1.8;
}

header {
  background: #101d30;
  padding: 30px 12px;
  text-align: center;
  border-bottom: 4px solid #00ff66;
}

header h1 {
  color: #00ff66;
  font-size: 36px;
  font-weight: 900;
}

h2 {
  color: #00ff66;
  font-size: 30px;
  margin: 22px 0;
  font-weight: 900;
}

h3 {
  color: #ffffff;
  font-size: 25px;
  font-weight: 900;
}

p, li {
  color: #ffffff;
  font-size: 21px;
  font-weight: 700;
  line-height: 1.8;
}

section, .match, .prediction, .card {
  background: #14243a;
  border: 2px solid #00e676;
  border-radius: 12px;
  padding: 20px;
  margin: 18px 10px;
}

button {
  background: #00e676;
  color: #001b0c;
  font-size: 21px;
  font-weight: 900;
  padding: 15px 22px;
  border: none;
  border-radius: 8px;
}

a {
  color: #00ff66;
  font-size: 20px;
  font-weight: 900;
}

.score, .prediction strong {
  color: #ffff00;
  font-size: 25px;
  font-weight: 900;
}

footer {
  background: #101d30;
  color: #ffffff;
  text-align: center;
  padding: 25px 12px;
  font-size: 20px;
  border-top: 4px solid #00ff66;
}

footer a {
  color: #00ff66;
  font-size: 22px;
  font-weight: 900;
}

@media (max-width: 600px) {
  body {
    font-size: 19px;
  }

  header h1 {
    font-size: 32px;
  }

  h2 {
    font-size: 27px;
  }

  p, li {
    font-size: 20px;
  }
}
