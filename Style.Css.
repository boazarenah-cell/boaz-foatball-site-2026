
/* =====================================
   BOAZ FOOTBALL - ORIGINAL DESIGN
   ===================================== */

* {
    box-sizing: border-box;
}

html,
body {
    background: #080d18 !important;
    color: #ffffff !important;
    margin: 0;
    padding: 0;
    font-family: Arial, sans-serif;
    font-size: 18px;
}

/* HEADER */

header {
    background: #101a2b !important;
    border-bottom: 2px solid #00ff41;
    padding: 20px;
    text-align: center;
}

header h1 {
    color: #00ff41 !important;
    font-size: 32px !important;
    font-weight: 900;
}

/* PAGE CONTENT */

main,
section {
    background: #080d18 !important;
    color: #ffffff !important;
}

section {
    padding: 15px;
}

section h2 {
    color: #00ff41 !important;
    font-size: 26px !important;
    font-weight: 900 !important;
    margin: 22px 0;
}

section h3 {
    color: #ffffff !important;
    font-size: 23px !important;
    font-weight: 900 !important;
}

/* MATCH CARDS */

.match-card {
    background: #142238 !important;
    border: 2px solid #087a35 !important;
    border-radius: 12px;
    padding: 18px !important;
    margin: 15px 0 !important;
    color: #ffffff !important;
}

.match-card h3,
.match-card h3:first-child {
    color: #ffffff !important;
    font-size: 23px !important;
    font-weight: 900 !important;
}

/* SCORES */

.match-card .score {
    color: #00ff41 !important;
    font-size: 25px !important;
    font-weight: 900 !important;
    margin: 12px 0;
}

/* PREDICTIONS */

.match-card .prediction,
.match-card .odds,
.match-card .stats {
    color: #69ff8c !important;
    font-size: 18px !important;
    font-weight: bold !important;
    line-height: 1.6;
}

/* FOOTER TEXT */

footer {
    background: #101a2b !important;
    color: #69ff8c !important;
    border-top: 2px solid #00ff41;
    padding: 20px;
    text-align: center;
}

/* LINKS */

a {
    color: #69ff8c !important;
    font-weight: bold;
}

/* WHATSAPP */

.whatsapp,
.contact-whatsapp {
    background: #087a35 !important;
    color: #ffffff !important;
    border: 2px solid #00ff41;
    border-radius: 10px;
    padding: 15px;
    display: block;
    text-align: center;
    font-size: 20px;
    font-weight: 900;
}

/* MOBILE */

@media (max-width: 600px) {
    section h2 {
        font-size: 24px !important;
    }

    .match-card {
        padding: 18px !important;
    }

    .match-card h3 {
        font-size: 23px !important;
    }

    .match-card .score {
        font-size: 25px !important;
    }
}
