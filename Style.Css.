
/* =====================================
   BOAZ FOOTBALL - PERMANENT DESIGN
   ===================================== */

* {
    box-sizing: border-box;
}

html, body {
    background: #080d18 !important;
    color: #ffffff !important;
    margin: 0;
    padding: 0;
    font-family: Arial, sans-serif;
    font-size: 18px;
}

header {
    background: #101a2b !important;
    color: #ffffff;
    text-align: center;
    padding: 22px 12px;
    border-bottom: 3px solid #00ff41;
}

header h1 {
    color: #00ff41 !important;
    font-size: 32px;
    font-weight: 900;
}

header p {
    color: #69ff8c;
    font-size: 19px;
    font-weight: bold;
}

main {
    padding: 15px;
}

.welcome {
    background: #142238;
    border: 2px solid #087a35;
    border-radius: 12px;
    padding: 20px;
    text-align: center;
    margin-bottom: 20px;
}

.welcome h2 {
    color: #00ff41;
    font-size: 25px;
    font-weight: 900;
}

.welcome p {
    color: #ffffff;
    font-size: 19px;
    font-weight: bold;
}

#predictions > h2 {
    color: #00ff41;
    font-size: 27px;
    text-align: center;
    font-weight: 900;
}

.match-card {
    background: #142238 !important;
    border: 2px solid #087a35 !important;
    border-radius: 12px;
    padding: 18px;
    margin: 15px 0;
    text-align: center;
}

.match-card h3,
.match-card .teams {
    color: #ffffff !important;
    font-size: 23px;
    font-weight: 900;
}

.score {
    color: #00ff41 !important;
    font-size: 25px;
    font-weight: 900;
}

.prediction,
.stats {
    color: #69ff8c !important;
    font-size: 19px;
    font-weight: bold;
    margin: 12px 0;
}

/* WHATSAPP CONTACT FOOTER */

.boaz-footer {
    background: #101a2b !important;
    color: #ffffff !important;
    text-align: center;
    padding: 25px 15px;
    margin-top: 30px;
    border-top: 3px solid #00ff41;
}

.boaz-footer h2 {
    color: #00ff41 !important;
    font-size: 25px;
    font-weight: 900;
}

.whatsapp-contact {
    display: inline-block;
    background: #087a35 !important;
    color: #ffffff !important;
    border: 2px solid #00ff41;
    border-radius: 12px;
    padding: 16px 20px;
    margin: 15px 0;
    font-size: 20px;
    font-weight: 900;
    text-decoration: none;
}

.phone {
    color: #00ff41 !important;
    font-size: 22px;
    font-weight: 900;
}

.boaz-footer p {
    color: #69ff8c !important;
    font-size: 18px;
    font-weight: bold;
}

/* MOBILE DISPLAY */

@media screen and (max-width: 600px) {
    header h1 {
        font-size: 29px;
    }

    .match-card h3 {
        font-size: 23px;
    }

    .whatsapp-contact {
        font-size: 18px;
    }
}
