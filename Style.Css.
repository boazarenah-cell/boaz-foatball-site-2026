/* BOAZ FOOTBALL - BIGGER, CLEARER TEXT */

body {
  font-size: 20px;
  line-height: 1.6;
}

header h1 {
  font-size: 36px;
  font-weight: 900;
}

h2 {
  font-size: 30px;
}

h3 {
  font-size: 25px;
}

.match-card {
  padding: 22px;
}

.match-card .teams,
.team-name {
  font-size: 24px;
  font-weight: 900;
  color: #ffffff;
}

.match-card .score {
  font-size: 30px;
  font-weight: 900;
  color: #00ff41;
}

.match-card p,
.match-card span,
.match-card td {
  font-size: 19px;
}

button,
a {
  font-size: 19px;
  font-weight: bold;
}

@media (max-width: 600px) {
  body {
    font-size: 19px;
  }

  header h1 {
    font-size: 32px;
  }

  .match-card .teams,
  .team-name {
    font-size: 22px;
  }

  .match-card .score {
    font-size: 27px;
  }
}
