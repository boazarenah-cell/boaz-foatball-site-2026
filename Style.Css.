

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  font-family: Arial, sans-serif;
  background: #080d18;
  color: #ffffff;
}

header {
  background: #101a2b;
  padding: 22px 15px;
  text-align: center;
  border-bottom: 2px solid #00e676;
}

header h1 {
  color: #00e676;
  font-size: 28px;
  font-weight: 900;
}

header p {
  color: #b8c5d6;
  margin-top: 7px;
}

nav {
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  gap: 20px;
  padding: 15px;
  background: #142238;
}

nav a {
  color: white;
  text-decoration: none;
  font-weight: bold;
}

nav a:hover {
  color: #00e676;
}

main {
  padding: 20px;
  max-width: 1100px;
  margin: auto;
}

h2 {
  color: #00e676;
  margin: 20px 0;
}

.match-card {
  background: #142238;
  border: 1px solid #263a55;
  border-radius: 12px;
  padding: 18px;
  margin-bottom: 15px;
  transition: 0.3s;
}

.match-card:hover {
  transform: translateY(-4px);
  border-color: #00e676;
}

.match-card h3 {
  margin-bottom: 12px;
}

.score {
  color: #00e676;
  font-size: 25px;
  font-weight: bold;
}

button {
  background: #00e676;
  color: #07120d;
  border: none;
  padding: 12px 20px;
  border-radius: 7px;
  font-weight: bold;
  cursor: pointer;
}

button:hover {
  background: #00c853;
}

input, select {
  padding: 12px;
  border-radius: 7px;
  border: 1px solid #34465e;
  background: #142238;
  color: white;
  width: 100%;
  margin: 8px 0;
}

footer {
  text-align: center;
  padding: 25px;
  background: #101a2b;
  color: #aab7c7;
  margin-top: 30px;
}

@media (max-width: 600px) {
  header h1 {
    font-size: 23px;
  }

  nav {
    gap: 12px;
  }

  main {
    padding: 12px;
  }
}
