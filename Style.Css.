
/* BOAZ FOOTBALL - PERMANENT DESIGN */

body {
  background: #080d18;
  color: #ffffff;
  font-family: Arial, sans-serif;
  font-size: 18px;
}

header {
  background: #101a2b;
  border-bottom: 2px solid #00ff41;
}

header h1 {
  color: #00ff41;
  font-size: 32px;
  font-weight: 900;
}

.match-card {
  background: #142238;
  border: 2px solid #087a35;
  border-radius: 12px;
  padding: 18px;
  margin: 15px 0;
}

.match-card h3,
.match-card .teams {
  color: #ffffff;
  font-size: 23px;
  font-weight: 900;
}

.score {
  color: #00ff41;
  font-size: 25px;
  font-weight: 900;
}

.prediction,
.odds,
.stats {
  color: #69ff8c;
  font-size: 18px;
  font-weight: bold;
}
