/* STRONG GREEN FOOTBALL THEME */

:root {
  --green: #00ff41;
  --dark-green: #00c853;
  --light-green: #69ff8c;
}

header {
  border-bottom: 4px solid var(--green);
}

header h1,
h2,
.score {
  color: var(--green);
}

.match-card {
  border: 2px solid #087a35;
  box-shadow: 0 0 10px rgba(0, 255, 65, 0.12);
}

.match-card:hover {
  border-color: var(--green);
  box-shadow: 0 0 16px rgba(0, 255, 65, 0.3);
}

nav a:hover {
  color: var(--green);
}

button {
  background: var(--green);
  color: #001b08;
}

button:hover {
  background: var(--dark-green);
}

footer {
  border-top: 2px solid var(--green);
}
